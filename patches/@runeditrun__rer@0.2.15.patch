diff --git a/cli/package-mode.mjs b/cli/package-mode.mjs
index 5e4f3d7e0670c33cb092d653981258feaa2ae332..ca8d64037fd77f1bbf898eb20914f1ec1001e082 100644
--- a/cli/package-mode.mjs
+++ b/cli/package-mode.mjs
@@ -39,8 +39,10 @@ export async function lockedPackage(root) {
   const entries = block(...own, `${group}:`, 4), entry = entries && block(...entries, `'${packageName}':`, 6);
   if (!entry) continue;
   const fields = Object.fromEntries(lines.slice(...entry).map(line => /^\s+(specifier|version):\s*'?([^'\s]*)'?\s*$/.exec(line)).filter(Boolean).map(match => [match[1], match[2]]));
-  const packages = block(0, lines.length, 'packages:', 0), resolved = packages && block(...packages, `'${packageName}@${fields.version}':`, 2);
-  return { group, specifier: fields.specifier, version: fields.version, locked: Boolean(resolved && lines.slice(...resolved).some(line => /^\s+resolution: \{integrity: sha512-/.test(line))) };
+  // pnpm keeps patched importer identities separate from the published package integrity.
+  const version = fields.version?.replace(/\(patch_hash=[a-f0-9]{64}\)$/, '');
+  const packages = block(0, lines.length, 'packages:', 0), resolved = packages && block(...packages, `'${packageName}@${version}':`, 2);
+  return { group, specifier: fields.specifier, version, locked: Boolean(resolved && lines.slice(...resolved).some(line => /^\s+resolution: \{integrity: sha512-/.test(line))) };
  }
  return undefined;
 }

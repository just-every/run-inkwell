import assert from 'node:assert/strict'
import {Inkwell,type Definition} from '../sdk/javascript/index.mjs'
export async function testExample(origin:string,key:string,definition:Definition){if(!key.startsWith('iwk_test_'))throw Error('Use a test-mode key.');const client=new Inkwell({origin,key});const {result}=await client.create(definition);const {envelope}=await client.get(result.id);if(!envelope.testMode)throw Error('Use a test-mode key.');await client.artifact(result.id,'original');await client.list();await client.send(result.id);assert.equal((await client.get(result.id)).envelope.status,'awaiting_signature');await client.correct(result.id,{signers:[{...(definition.signers![0] as object),email:'synthetic.corrected@clients.example'}]});assert.equal((await client.get(result.id)).envelope.signers[0].email,'synthetic.corrected@clients.example');const beforeResend=(await client.get(result.id)).envelope.events.filter(e=>e.action==='signer.resent').length;await client.resend(result.id,{signer:0});assert.equal((await client.get(result.id)).envelope.events.filter(e=>e.action==='signer.resent').length,beforeResend+1);await client.templates();await client.openapi();await client.void(result.id,'Synthetic example complete');assert.equal((await client.get(result.id)).envelope.status,'voided');return envelope}

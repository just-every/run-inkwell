{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signatures-inkwell",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": { "logs": { "enabled": true, "invocation_logs": false } },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundation",
      "database_id": "local-foundation-only",
      "migrations_dir": "migrations/core"
    }
  ]
}
